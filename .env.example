# ==============================================================================
# BankOS Backend - Variables de Entorno (Plantilla de Configuración)
# ==============================================================================

# Información de la Aplicación
PROJECT_NAME="BankOS API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# Seguridad y Autenticación JWT
SECRET_KEY="bankos-development-secret-key-change-this-in-production-min-32-chars-long!"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Base de Datos (PostgreSQL 15)
POSTGRES_SERVER="db"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_secure_password"
POSTGRES_DB="bankos_db"
# DATABASE_URL opcional: si se especifica sobrescribe los parámetros individuales
DATABASE_URL="postgresql+asyncpg://postgres:postgres_secure_password@db:5432/bankos_db"

# Caché, Idempotencia y Rate Limiting (Redis 7)
REDIS_HOST="redis"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0
# REDIS_URL opcional: si se especifica sobrescribe los parámetros individuales
REDIS_URL="redis://redis:6379/0"

# CORS
CORS_ORIGINS=["*"]

